# Demo mode: seeded data, no Supabase, no looot token. `npm run demo` sets this for you.
# NEXT_PUBLIC_DEMO=1

# Supabase project settings (Project Settings, API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# looot agent token. Server only, never sent to the browser.
# Create one at https://looot.ai/settings with catalog.read, runs.read and runs.execute.
LOOOT_TOKEN=your-looot-agent-token
# Optional, defaults to https://api.looot.ai
LOOOT_API_URL=https://api.looot.ai

# Scheduled checks (optional). Without these two /api/cron answers 401 or 501 and spends nothing.
# CRON_SECRET: any long random string. Vercel sends it to /api/cron.
CRON_SECRET=
# Service role key: server only, bypasses row level security, used by /api/cron alone.
SUPABASE_SERVICE_ROLE_KEY=
